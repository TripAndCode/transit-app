# Set CADDY_SITE_ADDRESS in .env:
#   • domain     → "transit-delay.app" (auto Let's Encrypt + HTTP→HTTPS)
#   • IP only    → ":80" (plain HTTP, Caddy default)
#   • staging LE → "transit-delay.app" + uncomment acme_ca below
#
# {$VAR:default} = use $VAR, else default.

{$CADDY_SITE_ADDRESS::80} {
	encode gzip zstd

	# Static assets fingerprinted by Vite — long cache.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8080

	log {
		output stdout
		format console
	}
}
