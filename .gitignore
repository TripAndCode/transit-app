__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
chroma_db/
gtfs.db
raw_archives/
raw_archives_static/
.env
.cloudflare_api.txt
# Claude Code — commit shared tools, ignore personal/runtime/docs
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
.claude/settings.local.json
.claude/**/*.local.md
.claude/**/.DS_Store
docs/*
!docs/deploy-railway.md
!docs/refactor-log.md
!docs/features/
specs/
.worktrees/
.superpowers/
# Contents pattern (not bare dir) so the negations below can re-include;
# ssh keys and poller logs under oracle_cloud/ stay ignored.
oracle_cloud/*
!oracle_cloud/v3/
# inside the re-included v3 tree: never track runtime data or key material
oracle_cloud/v3/data/
oracle_cloud/v3/**/*.key
frontend/node_modules
frontend/dist
api/static
# Stale tsc emit of vite.config.ts — kept biting the dev proxy because Vite
# prefers .js over .ts when both are present.
frontend/vite.config.js
frontend/vite.config.d.ts
client_secret_*.json
# Ad-hoc screenshots, scout artifacts, and Playwright MCP captures should
# never land in the repo root. Keep these catch-alls so `git status` stays
# noise-free after browser-driven debugging.
/*.png
/*.jpg
/*.gif
/*.pdf
.playwright-mcp/
.coverage
# scripts/prepare_review.py's own --output-dir, and any ad-hoc scratch
# file/directory a review pass creates when it can't write outside the repo
# (a sandboxed worker/coordinator without /tmp access falls back to a
# repo-relative path) — naming has never been consistent across sessions
# and has included both directories and loose files, so match every shape
# actually seen rather than one canonical name. No trailing slash on the
# root-level patterns below: some historical leftovers were bare `.diff`
# files, not directories, and a directory-only pattern silently misses
# those. These hold nothing but a diff/manifest of already-reviewed,
# already-public code, never secrets.
/review-scratch*
/.review-scratch*
/tmp-review-item*
/tmp_review_item*
# mktemp -d's own unthemed default template (10 random alphanumeric
# chars) when a scratch dir is created directly in the repo root instead
# of under a real tmpdir — this shape carries no "review"/"scratch"/"item"
# substring to match on, so it needs its own pattern; kept root-anchored
# and exactly 10 chars to avoid matching an unrelated real path.
/tmp.??????????
scripts/review-*-pass*/
scripts/.review-scratch/
