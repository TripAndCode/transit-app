{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dev-db.sh\"" },
          {
            "type": "command",
            "timeout": 3600,
            "statusMessage": "Pre-push gate: ruff fmt/lint + mypy + tests + frontend typecheck/test/lint/i18n/build/entry-chunk",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push-quality.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Edit(.claude/skills/**)"]
  }
}
