# Collector v3 cron jobs (pollers run under systemd, NOT cron).
CRON_TZ=Asia/Tokyo
# Every job runs under bin/cron-wrap.sh: cron.log still gets the job's full
# output, and a nonzero exit additionally pings ALERT_PING_URL/fail with the
# job name, its status, and the tail of that output. Without the wrapper a
# failure is only ever written to cron.log, where nobody sees it.
# ALERT_PING_URL (and the OBJECT_STORE_* vars sync-r2.sh needs, plus
# SPOOL_DISK_BUDGET_BYTES for spool-cleanup.sh) live in /etc/environment —
# cron does not source ~/.bashrc.
#
# 5-minute offsets are generous, not exact: static-fetch.sh/rotate-day.sh
# write via mktemp+atomic mv, so even a slow run overlapping the next job
# never exposes a partial file to sync-r2.sh's include filters -- worst
# case is one file syncing a day late, never corruption or loss.
0  9 * * *  nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/static-fetch.sh >> /home/opc/collector/cron.log 2>&1
5  9 * * *  nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/rotate-day.sh  >> /home/opc/collector/cron.log 2>&1
10 9 * * *  set -a; . /etc/environment; set +a; env AWS_CLI=/usr/local/bin/aws nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/sync-r2.sh     >> /home/opc/collector/cron.log 2>&1
# verify-r2.sh independently lists each configured agency's actual R2
# objects and checks freshness + byte-size integrity, rather than trusting
# sync-r2.sh's own exit status -- runs right after it, same env sourcing.
15 9 * * *  set -a; . /etc/environment; set +a; env AWS_CLI=/usr/local/bin/aws nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/verify-r2.sh  >> /home/opc/collector/cron.log 2>&1
# spool-cleanup.sh reclaims local disk immediately, file by file, the moment
# R2 actually confirms (its own listing + byte-size match, not just trusting
# sync-r2.sh's exit status) that a specific RT/static archive is uploaded --
# rather than waiting out prune.sh's much longer age-based retention window
# below. A failed/partial upload is left in place for the next sync-r2.sh run
# to retry, and exceeding SPOOL_DISK_BUDGET_BYTES is reported as a failure,
# never as a further deletion. Idempotent: safe to run daily.
20 9 * * *  set -a; . /etc/environment; set +a; env AWS_CLI=/usr/local/bin/aws nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/spool-cleanup.sh  >> /home/opc/collector/cron.log 2>&1
# prune.sh REFUSES to run (exit 65) unless sync-r2.sh's .sync-r2.last-ok
# marker is fresh (see both scripts) -- replaces the old "workstation
# mirror" (this repo's make fetch + make sync-r2) as prune's actual,
# enforced parity gate, not just a documented assumption. That refusal is
# itself a nonzero exit, so the wrapper pages on it instead of letting a
# real R2 outage show up only as prune.sh silently skipping its weekly run.
30 9 * * 0  /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/prune.sh                  >> /home/opc/collector/cron.log 2>&1
# prune-r2.sh enforces the same kind of parity gate as prune.sh above, but
# against R2's own much longer retention window (R2 is the durable archive,
# not a 90-day rolling buffer) -- see the script for why the defaults differ
# so much from prune.sh's.
35 9 * * 0  set -a; . /etc/environment; set +a; env AWS_CLI=/usr/local/bin/aws nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/prune-r2.sh    >> /home/opc/collector/cron.log 2>&1
# reconcile-r2.sh covers what prune-r2.sh's own age-based sweep cannot: an R2
# object under an agency id no longer in agencies.tsv, or one whose filename
# doesn't match the rt/<id>/<YYYYMMDD>.tar.gz / static/<id>/gtfs_static_
# <YYYYMMDD>.zip naming rule at all. Deliberately runs WITHOUT --execute here
# -- it only reports orphans (a nonzero exit when it finds any, so cron-wrap
# pages on it like any other problem) for a human to review in cron.log
# before ever deleting anything; `--execute` is a separate, manual step.
40 9 * * 0  set -a; . /etc/environment; set +a; env AWS_CLI=/usr/local/bin/aws nice -n 10 /home/opc/collector/bin/cron-wrap.sh /home/opc/collector/bin/reconcile-r2.sh    >> /home/opc/collector/cron.log 2>&1
# health-check.sh is deliberately NOT wrapped: it sends its own ok/fail pings,
# and the wrapper would report every problem it finds a second time. Its
# cadence is also what makes the check's own period/grace alarm meaningful --
# a VM that is down or a cron that stopped firing can only be caught by the
# all-clear failing to arrive.
*/30 * * * * /home/opc/collector/bin/health-check.sh >> /home/opc/collector/cron.log 2>&1
