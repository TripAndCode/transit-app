# Install: sudo cp rt-poller@.service /etc/systemd/system/ && sudo systemctl daemon-reload
# Enable:  sudo systemctl enable --now rt-poller@1 rt-poller@8 rt-poller@9 rt-poller@10 rt-poller@11 rt-poller@12 rt-poller@13 rt-poller@14 rt-poller@15 rt-poller@17 rt-poller@18 rt-poller@19 rt-poller@53 rt-poller@54
[Unit]
Description=GTFS-RT poller agency %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
ExecStart=/home/opc/collector/bin/rt-poller.sh %i
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
