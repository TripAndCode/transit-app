# Example env file for transit-drift-check.service.
# Copy to /etc/transit/drift-check.env (mode 0600, NOT committed) and fill in
# the DEPLOYED stores. Do not reuse the local dev :5433 string. The required
# values are left empty, so an unedited copy exits 2 rather than trying them.

# postgresql://USER:PASSWORD@HOST:5432/transit
DATABASE_URL=

# The aggregate check also opens ClickHouse; drift_check.sh exits 2 without
# the user, password and database. Set the host unless ClickHouse runs on this
# host: it defaults to localhost, but only while unset, since an empty value
# is taken as the host. Leave the port unset to take its default, 8123, or 8443
# with CLICKHOUSE_SECURE=true.
# CLICKHOUSE_HOST=
# CLICKHOUSE_PORT=
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
