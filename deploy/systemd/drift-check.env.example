# Example env file for transit-drift-check.service.
# Copy to /etc/transit/drift-check.env (mode 0600, NOT committed) and set the
# real values for the DEPLOYED stores. Do not reuse the local dev :5433 string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/transit

# The aggregate check also opens ClickHouse. drift_check.sh refuses to run
# without the user, password and database. The host defaults to localhost,
# which is right only when ClickHouse runs on the same host as this unit; the
# port defaults to 8123, or 8443 with CLICKHOUSE_SECURE=true.
CLICKHOUSE_HOST=HOST
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=USER
CLICKHOUSE_PASSWORD=PASSWORD
CLICKHOUSE_DATABASE=transit
