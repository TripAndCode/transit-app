# Example env file for ops-status.service.
# Copy to /etc/transit/ops-status.env (mode 0600, NOT committed) and set a real
# random token:
#   openssl rand -hex 32
OPS_STATUS_TOKEN=

# Optional overrides (defaults: 127.0.0.1:8642). Only widen the bind address if
# access is already restricted some other way (firewall, VPN) -- the Basic-auth
# gate is defense in depth on top of a restricted bind, not a substitute for one.
# OPS_STATUS_HOST=127.0.0.1
# OPS_STATUS_PORT=8642

# Only needed if this service's deployed checkout differs from ops-status.service's
# own WorkingDirectory= default (/root/transit-app) -- keep the two in sync otherwise.
# OPS_STATUS_REPO=/root/transit-app
