# Polls ops-alerts.service every 5 minutes. Independent of ops-status.service's
# own on-demand HTTP page -- this timer is what actually drives anomaly
# detection; the HTTP page is only a human-readable view of the same
# underlying collectors.
[Unit]
Description=Run ops-alerts.service every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
