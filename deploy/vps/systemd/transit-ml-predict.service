[Unit]
Description=Daily forecast publish
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/transit-app
EnvironmentFile=/etc/transit-ml/env
ExecStart=/root/transit-app/deploy/vps/run-with-ping.sh PREDICT /root/transit-app/.venv/bin/python -m ml.cli predict --model /var/lib/transit-ml/model --out /var/lib/transit-ml/forecast/forecast.parquet
Nice=10
