[Unit]
Description=Score the published live forecasts against what ran, and publish the scorecard
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/transit-app
EnvironmentFile=/etc/transit-ml/env
ExecStart=/root/transit-app/deploy/vps/run-with-ping.sh LIVE_SCORE /root/transit-app/.venv/bin/python -m ml.cli live-score --out /var/lib/transit-ml/backtests/live.json --publish
Nice=10
