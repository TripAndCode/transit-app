[Unit]
Description=Score the delay baselines and models, render the report, and publish the evaluation
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/transit-app
EnvironmentFile=/etc/transit-ml/env
ExecStart=/root/transit-app/deploy/vps/run-with-ping.sh BACKTEST /bin/sh -c '/root/transit-app/.venv/bin/python -m ml.cli backtest --out /var/lib/transit-ml/backtests/latest.json && /root/transit-app/.venv/bin/python -m ml.cli train-eval --out /var/lib/transit-ml/backtests/models.json && /root/transit-app/.venv/bin/python -m ml.cli report --in /var/lib/transit-ml/backtests/latest.json --models /var/lib/transit-ml/backtests/models.json --out /var/lib/transit-ml/reports/latest/index.html && /root/transit-app/.venv/bin/python -m ml.cli train --backtest /var/lib/transit-ml/backtests/models.json --out /var/lib/transit-ml/model && /root/transit-app/.venv/bin/python -m ml.cli publish-eval --models /var/lib/transit-ml/backtests/models.json --out /var/lib/transit-ml/backtests/summary.json --model-meta /var/lib/transit-ml/model/meta.json'
Nice=10
