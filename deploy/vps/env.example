# /etc/transit-ml/env on the VPS: root-owned, mode 600, never committed.
ML_PG_PASSWORD=
ML_CH_PASSWORD=
DATABASE_URL=postgresql://transit:<ML_PG_PASSWORD>@127.0.0.1:15432/transit
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=18123
CLICKHOUSE_USER=transit
CLICKHOUSE_PASSWORD=<ML_CH_PASSWORD>
CLICKHOUSE_DATABASE=transit
# A read-only R2 token scoped to the transit-archives bucket alone.
OBJECT_STORE_BUCKET=transit-archives
OBJECT_STORE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# A separate, read-write R2 token scoped to the transit-ml bucket alone. Every
# ml job that writes the bucket (train, predict, publish-eval) swaps
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for this pair just before uploading,
# so sync's read-only pair above is never exposed to a process that writes.
ML_STORE_BUCKET=transit-ml
ML_STORE_ENDPOINT=
ML_STORE_ACCESS_KEY_ID=
ML_STORE_SECRET_ACCESS_KEY=
HC_PING_URL_SYNC=
HC_PING_URL_BACKTEST=
HC_PING_URL_PREDICT=
