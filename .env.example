# ── API / LLM ─────────────────────────────────────────────────────────────────
# Ordered fallback list. The Ask tab tries each provider in turn and falls
# back to the next on rate-limit (429), connection error, or timeout. Each
# provider needs its own env block below. The default ("groq") preserves
# pre-Phase-1.5 behaviour for operators who only have a Groq key.
CHAT_PROVIDERS=cerebras,groq

# Cerebras free Personal tier: 1M tokens/day, 2,400 req/day, 5 req/min.
# gpt-oss-120b is the strongest tool-caller on the account. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Groq free tier: 100K tokens/day. https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama local fallback (optional). Unmetered if running. Add "ollama" to
# CHAT_PROVIDERS to enable. The API key is ignored by Ollama itself.
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_BASE_URL=http://localhost:11434/v1

# LLM-grounded Ask follow-up (off by default). The free-text answer is only as
# injection-safe as the provider that serves it: Groq llama-3.3-70b obeys
# injected instructions that Cerebras gpt-oss-120b resists. ASK_FOLLOWUP_PROVIDERS
# restricts the follow-up to a subset of CHAT_PROVIDERS (default cerebras); when
# none are available the follow-up degrades gracefully rather than using a
# disallowed provider. Verify with: poetry run python scripts/followup_eval.py
# ASK_FOLLOWUP_ENABLED=false
# ASK_FOLLOWUP_PROVIDERS=cerebras

# Feature flag for the canonical-intent cache + guided-UX path. When false
# (default), the Ask tab behaves exactly as Phase ① — direct LLM tool dispatch,
# no cache reads/writes. When true: Stage 3 uses JSON-mode signature output,
# paraphrases collapse to a shared ask_intent_cache row, and the frontend shows
# the chips / build mode / confidence pill UX. Flip back to false for rollback.
ASK_INTENT_CACHE_ENABLED=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Raw GTFS-RT observations (`updates`) live in ClickHouse, not Postgres —
# see docs/superpowers/specs/2026-08-04-clickhouse-updates-migration-design.md
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=transit
CLICKHOUSE_PASSWORD=transit
CLICKHOUSE_DATABASE=transit

# ── API server ────────────────────────────────────────────────────────────────
# Same-origin deploys (SPA served by FastAPI in one container, e.g. Railway) need
# no CORS — the SPA is served by FastAPI itself. Only set this for split deploys or when running the
# Vite dev server (default :5173) against a separate API origin.
CORS_ORIGINS=http://localhost:5173

# ── Cron secret (ingest_live FALLBACK endpoint) ───────────────────────────────
# Production normally ingests Oracle archives via the daily Railway job (object
# storage block below). CRON_SECRET only gates the lower-fidelity fallback —
# POST /internal/cron/ingest, which runs ingest_live. Set it identically on the
# app container and on whatever external scheduler pokes the endpoint.
#   openssl rand -hex 32
CRON_SECRET=

# ── Production ingest (Oracle archives → object storage → daily Railway job) ──
# Oracle uploads its per-day, per-agency archive zips to S3-compatible object
# storage; the daily Railway `ingest` service pulls them over HTTPS and runs
# ingest → analyze_all → prune into the private DB. See docs/deploy-railway.md.
# OBJECT_STORE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OBJECT_STORE_BUCKET=transit-archives
# OBJECT_STORE_ACCESS_KEY_ID=
# OBJECT_STORE_SECRET_ACCESS_KEY=
# RETENTION_DAYS=400   # prune raw `updates` older than this (reports max range 365d)

# ── Database password (local compose db + deployed db) ───────────────────────
# Read by the local compose `db` service and by the deployed Postgres service
# (see docs/deploy-railway.md). Replace "transit" with `openssl rand -hex 24`
# before exposing anything publicly.
POSTGRES_PASSWORD=transit

# ── Oracle Cloud archive replay (LOCAL DEV transport) ─────────────────────────
# Lets `make fetch-ingest` rsync historical .pb tar.gz from the collector VM and
# replay them locally. Production ingests the SAME archives, but via object
# storage (block above) rather than SSH — these vars are the local-dev transport
# only. Skip unless you're working with the Aomori-team archive server.
ORACLE_HOST=64.110.114.101         # OCI instance public IP
ORACLE_USER=opc                    # default OCI username
ORACLE_SSH_KEY_PATH=/Users/you/oracle_cloud/ssh-key-2026-03-28.key
# ORACLE_SSH_KEY=                  # base64 -i ssh-key-2026-03-28.key | pbcopy
# ORACLE_RT_DIR=/home/opc/app/transportation_analysis/archive
# ORACLE_STATIC_DIR=/home/opc/app/transportation_analysis/static_archive

# Perf debug surface (/api/debug/perf). Unauthenticated when on — dev only.
PERF_DEBUG_ENABLED=false

# ── Pipeline ──────────────────────────────────────────────────────────────────
AGENCY_ID=1

# ── Frontend (build-time) ─────────────────────────────────────────────────────
# Override only when API + frontend live on different origins
# VITE_API_BASE_URL=

# Override when using non-OSM tiles (e.g. Carto, MapTiler). Default = OSM raster.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY

# ── Auth / SSO ────────────────────────────────────────────────────────────────
# OAuth2 / OIDC credentials for the two providers we support. Register apps at:
#   Google:  https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client)
#   GitHub:  https://github.com/settings/developers              (OAuth Apps)
# Redirect URI is ``${PUBLIC_BASE_URL}/api/auth/{google|github}/callback``.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SIGNING_KEY=  # openssl rand -hex 32
SESSION_COOKIE_NAME=sid
PUBLIC_BASE_URL=http://localhost:8000
SESSION_TTL_DAYS=30
ADMIN_EMAILS=  # comma-separated; first login from these emails promotes to admin

# ── Collector v3 (per-agency layout on the Oracle VM) ─────────────────────────
# Set after the v3 migration (oracle_cloud/v3/MIGRATION.md). When set,
# fetch_archives.sh / fetch_and_ingest.sh use per-agency dirs and loop over
# all agencies from agencies.csv; when unset, legacy flat single-agency
# behavior is preserved.
# COLLECTOR_DATA_DIR=/home/opc/collector/data
# AGENCY_IDS=1 8 9 10   # optional override; default = agencies.csv rows with feed_url
