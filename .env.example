# ── API / LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...               # console.groq.com → API Keys

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── API server ────────────────────────────────────────────────────────────────
# Same-origin (single Fly Machine) needs no CORS — the SPA is served by
# FastAPI itself. Only set this for split deploys or when running the Vite dev
# server (default :5173) against a separate API origin.
CORS_ORIGINS=http://localhost:5173

# ── Cron (production) ─────────────────────────────────────────────────────────
# A GitHub Actions workflow hits POST /internal/cron/ingest hourly. Both this
# env var (set on Fly via `fly secrets set`) and the matching repo secret
# (CRON_SECRET in GH Actions) must hold the same random string.
#
#   openssl rand -hex 32 | tee /tmp/secret
#   fly secrets set CRON_SECRET="$(cat /tmp/secret)"
#   gh secret set CRON_SECRET --body "$(cat /tmp/secret)"
#   gh secret set APP_BASE_URL --body "https://<your-fly-app>.fly.dev"
CRON_SECRET=

# ── Oracle Cloud archive replay (LOCAL DEV ONLY) ──────────────────────────────
# Optional: lets `make fetch-ingest` rsync historical .pb tar.gz from a side-
# channel scraper VM and replay them locally. Production deploys ingest live
# directly via `ingest_live` (the cron endpoint above). Skip this whole block
# unless you're working with the Aomori-team archive server.
ORACLE_HOST=64.110.114.101         # OCI instance public IP
ORACLE_USER=opc                    # default OCI username
ORACLE_SSH_KEY_PATH=/Users/you/oracle_cloud/ssh-key-2026-03-28.key
# ORACLE_SSH_KEY=                  # base64 -i ssh-key-2026-03-28.key | pbcopy
# ORACLE_RT_DIR=/home/opc/app/transportation_analysis/archive
# ORACLE_STATIC_DIR=/home/opc/app/transportation_analysis/static_archive

# ── Pipeline ──────────────────────────────────────────────────────────────────
AGENCY_ID=1

# ── Frontend (build-time) ─────────────────────────────────────────────────────
# Override only when API + frontend live on different origins
# VITE_API_BASE_URL=

# Override when using non-OSM tiles (e.g. Carto, MapTiler). Default = OSM raster.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY
