{
  "name": "transit-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip",
    "lint:i18n": "cd .. && node --test tests/frontend/i18n_keys.test.mjs tests/frontend/user_manual_parity.test.mjs",
    "lint:i18n-strings": "python3 scripts/lint-i18n-strings.py",
    "check:entry-chunk": "node scripts/check-entry-chunk.mjs",
    "test:check-entry-chunk": "cd .. && node --test tests/frontend/check_entry_chunk.test.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "test:check-css-tokens": "cd .. && node --test tests/frontend/check_css_tokens.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^4.7.1",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "knip": "^6.37.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
