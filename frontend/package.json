{
  "name": "transit-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "node --require ./scripts/ts6-for-eslint.cjs ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node --require ./scripts/ts6-for-eslint.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "deadcode": "knip",
    "i18n:set": "node scripts/i18n-set.mjs",
    "lint:i18n": "cd .. && node --test tests/frontend/i18n_keys.test.mjs tests/frontend/user_manual_parity.test.mjs tests/frontend/i18n_glossary.test.mjs",
    "lint:i18n-strings": "python3 scripts/lint-i18n-strings.py",
    "check:entry-chunk": "node scripts/check-entry-chunk.mjs",
    "test:check-entry-chunk": "cd .. && node --test tests/frontend/check_entry_chunk.test.mjs tests/frontend/locale_chunk_map.test.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "test:check-css-tokens": "cd .. && node --test tests/frontend/check_css_tokens.test.mjs",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "test:check-react-compiler": "cd .. && node --test tests/frontend/check_react_compiler.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.71.0",
    "maplibre-gl": "^6.17.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.45.0",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
