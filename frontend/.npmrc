# typescript-eslint declares `typescript: >=4.8.4 <6.1.0` and this project is on
# 7, so npm's peer resolution rejects the tree outright -- see
# scripts/ts6-for-eslint.cjs for why 7 is the version here and how the linter
# still gets a 6.x compiler at runtime. Scoped `overrides` cannot express it:
# npm refuses to nest a second copy for a peer edge, and overriding the range
# crashes the installer.
#
# The cost of this flag is that npm no longer installs peers automatically, so
# a peer this project actually needs has to be a direct dependency --
# @testing-library/dom is the one that was only reachable that way. Remove this
# file together with the shim when typescript-eslint supports TS 7.
legacy-peer-deps=true
